    <test thread-count="5" name="Regreesion Test">
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="Tests.T1_DBRegisterTest"/>
        </classes>
    </test>

    <test thread-count="5" name="SmokeTest">
        <parameter name="browser" value="edge"></parameter>
        <classes>
